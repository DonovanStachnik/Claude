//@version=5
indicator("Multi-Timeframe Swing Trading Strategy", overlay=true, max_labels_count=500, max_lines_count=500)

// ==================================================================================
// SWING TRADING STRATEGY - HIGH PROBABILITY SIGNALS
// ==================================================================================
// Strategy: 1-8 week swing trades targeting 20-100% moves
// Sizing: 5-8% per trade (manual execution)
// Entry: Multi-timeframe alignment (1W + 1D trend + 4H confirm + 1H entry)
// Exit: -10% hard stop, trim 30% at +20%, 40% at +50%, trail rest
// Minimum: 6+ criteria must align for HIGH QUALITY signals only
// ==================================================================================

// INPUT PARAMETERS
// ==================================================================================

// Timeframe Settings
string tf1h = input.timeframe("60", "1H Timeframe", group="Timeframes")
string tf4h = input.timeframe("240", "4H Timeframe", group="Timeframes")
string tf1d = input.timeframe("D", "1D Timeframe", group="Timeframes")
string tf1w = input.timeframe("W", "1W Timeframe", group="Timeframes")

// Indicator Settings
int rsiLength = input.int(14, "RSI Length", minval=1, group="Indicators")
int rsiOversold = input.int(25, "RSI Oversold (Deeper for swings)", minval=0, maxval=50, group="Indicators")
int rsiOverbought = input.int(75, "RSI Overbought (Higher for swings)", minval=50, maxval=100, group="Indicators")

int macdFast = input.int(12, "MACD Fast", minval=1, group="Indicators")
int macdSlow = input.int(26, "MACD Slow", minval=1, group="Indicators")
int macdSignal = input.int(9, "MACD Signal", minval=1, group="Indicators")

int stochLength = input.int(14, "Stochastic Length", minval=1, group="Indicators")
int stochK = input.int(3, "Stochastic %K Smooth", minval=1, group="Indicators")
int stochD = input.int(3, "Stochastic %D Smooth", minval=1, group="Indicators")

int bbLength = input.int(20, "Bollinger Bands Length", minval=1, group="Indicators")
float bbMult = input.float(2.0, "Bollinger Bands Multiplier", minval=0.1, group="Indicators")

int adxLength = input.int(14, "ADX Length", minval=1, group="Indicators")
float adxThreshold = input.float(30, "ADX Trend Strength (Higher = Stronger)", minval=0, group="Indicators")

int volumeLength = input.int(20, "Volume MA Length", minval=1, group="Indicators")
float volumeIncrease = input.float(30, "Volume Increase % (Higher = Confirmation)", minval=0, group="Indicators")

// Suite Diamonds Settings (Custom momentum indicator)
int suiteFastLength = input.int(8, "Suite Fast EMA", minval=1, group="Suite Diamonds")
int suiteSlowLength = input.int(21, "Suite Slow EMA", minval=1, group="Suite Diamonds")
int suiteSignalLength = input.int(5, "Suite Signal SMA", minval=1, group="Suite Diamonds")

// Green Mountain Settings (Trend strength indicator)
int gmTrendLength = input.int(50, "Green Mountain Trend Length", minval=1, group="Green Mountain")
int gmMomentumLength = input.int(14, "Green Mountain Momentum Length", minval=1, group="Green Mountain")

// Risk Management
float stopLossPct = input.float(10.0, "Stop Loss %", minval=0.1, maxval=50, group="Risk Management")
float firstTargetPct = input.float(20.0, "First Target % (Trim 30%)", minval=0.1, group="Risk Management")
float secondTargetPct = input.float(50.0, "Second Target % (Trim 40%)", minval=0.1, group="Risk Management")
float thirdTargetPct = input.float(100.0, "Third Target % (Moon Shot)", minval=0.1, group="Risk Management")

// Signal Settings
int minCriteria = input.int(6, "Minimum Criteria (6+ = Quality Swings)", minval=1, maxval=10, group="Signal Settings")
bool showStopLoss = input.bool(true, "Show Stop Loss Lines", group="Signal Settings")
bool showTargets = input.bool(true, "Show Target Lines", group="Signal Settings")
int minBarsFromLast = input.int(20, "Min Bars Between Signals (Avoid Overtrading)", minval=1, group="Signal Settings")

// Visual Settings
color buyColor = input.color(color.new(#00CED1, 0), "Buy Signal Color (Tealish Blue)", group="Visual")
color sellColor = input.color(color.new(#FF1493, 0), "Sell Signal Color (Pink)", group="Visual")

// ==================================================================================
// HELPER FUNCTIONS
// ==================================================================================

// Calculate EMA
emaCalc(src, length) =>
    ta.ema(src, length)

// Calculate SMA
smaCalc(src, length) =>
    ta.sma(src, length)

// ==================================================================================
// SUITE DIAMONDS INDICATOR
// ==================================================================================
// Blue diamonds (2+) = buy signal, Pink diamonds (2+) = sell signal
// Above zero = late trend, Below zero = early reversal (prefer below for entries)

suiteFastEma = emaCalc(close, suiteFastLength)
suiteSlowEma = emaCalc(close, suiteSlowLength)
suiteMacd = suiteFastEma - suiteSlowEma
suiteSignal = smaCalc(suiteMacd, suiteSignalLength)
suiteHistogram = suiteMacd - suiteSignal

// Suite Diamond Signals
suiteBlueDiamond = ta.crossover(suiteMacd, suiteSignal) and suiteMacd > 0  // Late uptrend
suiteBlueDiamondEarly = ta.crossover(suiteMacd, suiteSignal) and suiteMacd <= 0  // Early reversal (preferred)
suitePinkDiamond = ta.crossunder(suiteMacd, suiteSignal) and suiteMacd < 0  // Late downtrend
suitePinkDiamondEarly = ta.crossunder(suiteMacd, suiteSignal) and suiteMacd >= 0  // Early reversal

// Count recent diamonds (last 5 bars)
var int blueDiamondCount = 0
var int pinkDiamondCount = 0

if suiteBlueDiamond or suiteBlueDiamondEarly
    blueDiamondCount := 1
    pinkDiamondCount := 0
else if suitePinkDiamond or suitePinkDiamondEarly
    pinkDiamondCount := 1
    blueDiamondCount := 0
else
    if bar_index > 0
        blueDiamondCount := blueDiamondCount > 0 ? blueDiamondCount + 1 : 0
        pinkDiamondCount := pinkDiamondCount > 0 ? pinkDiamondCount + 1 : 0
    if blueDiamondCount > 5
        blueDiamondCount := 0
    if pinkDiamondCount > 5
        pinkDiamondCount := 0

suiteBuySignal = blueDiamondCount >= 1 and blueDiamondCount <= 5
suiteSellSignal = pinkDiamondCount >= 1 and pinkDiamondCount <= 5

// ==================================================================================
// GREEN MOUNTAIN INDICATOR
// ==================================================================================
// Green mountain = uptrend strength; loss of green = exhaustion

gmTrend = emaCalc(close, gmTrendLength)
gmMomentum = close - gmTrend
gmStrength = gmMomentum / gmTrend * 100

// Green mountain conditions
greenMountainUp = gmStrength > 0 and gmStrength > gmStrength[1]  // Building strength
greenMountainLoss = gmStrength < gmStrength[1] and gmStrength[1] > 0  // Losing strength (exhaustion)

// ==================================================================================
// VWAP CALCULATION
// ==================================================================================

vwapValue = ta.vwap(hlc3)
vwapReclaim = ta.crossover(close, vwapValue)  // Price reclaims VWAP (bullish 1H entry)
vwapLoss = ta.crossunder(close, vwapValue)  // Price loses VWAP (bearish)

// ==================================================================================
// VOLUME ANALYSIS
// ==================================================================================

volumeMA = smaCalc(volume, volumeLength)
volumeIncreased = volume > volumeMA * (1 + volumeIncrease / 100)

// ==================================================================================
// RSI CALCULATION
// ==================================================================================

rsiValue = ta.rsi(close, rsiLength)
rsiOversoldCond = rsiValue < rsiOversold
rsiOverboughtCond = rsiValue > rsiOverbought

// ==================================================================================
// MACD CALCULATION
// ==================================================================================

[macdLine, signalLine, _] = ta.macd(close, macdFast, macdSlow, macdSignal)
macdBullishCross = ta.crossover(macdLine, signalLine)
macdBearishCross = ta.crossunder(macdLine, signalLine)

// ==================================================================================
// STOCHASTIC CALCULATION
// ==================================================================================

stochK_value = ta.sma(ta.stoch(close, high, low, stochLength), stochK)
stochD_value = ta.sma(stochK_value, stochD)

stochBounce = stochK_value > 20 and stochK_value < 80 and ta.crossover(stochK_value, stochD_value)
stochTop = stochK_value > 20 and stochK_value < 80 and ta.crossunder(stochK_value, stochD_value)

// ==================================================================================
// BOLLINGER BANDS CALCULATION
// ==================================================================================

bbBasis = smaCalc(close, bbLength)
bbDev = bbMult * ta.stdev(close, bbLength)
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev
bbWidth = bbUpper - bbLower
bbWidthMA = smaCalc(bbWidth, bbLength)

bbSqueeze = bbWidth < bbWidthMA * 0.5  // Tight squeeze = potential breakout
bbBreakoutUp = ta.crossover(close, bbUpper)
bbBreakoutDown = ta.crossunder(close, bbLower)

// ==================================================================================
// ADX CALCULATION (Trend Strength)
// ==================================================================================

[diPlus, diMinus, adxValue] = ta.dmi(adxLength, adxLength)
adxStrong = adxValue > adxThreshold

// ==================================================================================
// MULTI-TIMEFRAME ANALYSIS
// ==================================================================================

// 1H Timeframe (Entry signals)
vwap1H = request.security(syminfo.tickerid, tf1h, vwapValue)
vwapReclaim1H = request.security(syminfo.tickerid, tf1h, vwapReclaim)
rsi1H = request.security(syminfo.tickerid, tf1h, rsiValue)
macdBullish1H = request.security(syminfo.tickerid, tf1h, macdBullishCross)
volume1H = request.security(syminfo.tickerid, tf1h, volumeIncreased)

// 4H Timeframe (Confirmation - higher lows for longs)
high4H = request.security(syminfo.tickerid, tf4h, high)
low4H = request.security(syminfo.tickerid, tf4h, low)
close4H = request.security(syminfo.tickerid, tf4h, close)
higherLow4H = low4H > low4H[1] and low4H[1] > low4H[2]  // Forming higher lows
lowerHigh4H = high4H < high4H[1] and high4H[1] < high4H[2]  // Forming lower highs

// 1D Timeframe (Trend direction)
ema50_1D = request.security(syminfo.tickerid, tf1d, emaCalc(close, 50))
ema200_1D = request.security(syminfo.tickerid, tf1d, emaCalc(close, 200))
close1D = request.security(syminfo.tickerid, tf1d, close)

dailyUptrend = close1D > ema50_1D and ema50_1D > ema200_1D  // Clear uptrend
dailyDowntrend = close1D < ema50_1D and ema50_1D < ema200_1D  // Clear downtrend
dailyReversal = (close1D < ema50_1D and close1D > ema200_1D) or (close1D > ema50_1D and close1D < ema200_1D)  // Reversal zone

// 1W Timeframe (Major trend - for BIG moves)
ema20_1W = request.security(syminfo.tickerid, tf1w, emaCalc(close, 20))
ema50_1W = request.security(syminfo.tickerid, tf1w, emaCalc(close, 50))
close1W = request.security(syminfo.tickerid, tf1w, close)
rsi1W = request.security(syminfo.tickerid, tf1w, ta.rsi(close, 14))

weeklyUptrend = close1W > ema20_1W and ema20_1W > ema50_1W  // Strong weekly uptrend
weeklyDowntrend = close1W < ema20_1W and ema20_1W < ema50_1W  // Strong weekly downtrend
weeklyOversold = rsi1W < 35  // Weekly oversold (major reversal potential)
weeklyOverbought = rsi1W > 65  // Weekly overbought (major top potential)

// ==================================================================================
// CONFLUENCE SCORING SYSTEM (10 CRITERIA)
// ==================================================================================

// BUY Criteria (Optimized for BIG SWINGS)
int buyScore = 0
buyScore := buyScore + ((weeklyUptrend or weeklyOversold) ? 1 : 0)  // 1. Weekly trend up OR oversold reversal setup
buyScore := buyScore + (dailyUptrend or dailyReversal ? 1 : 0)  // 2. Daily trend favorable or reversal
buyScore := buyScore + (higherLow4H ? 1 : 0)  // 3. 4H forming higher lows (structure)
buyScore := buyScore + (vwapReclaim1H ? 1 : 0)  // 4. 1H VWAP reclaim (entry timing)
buyScore := buyScore + (volumeIncreased ? 1 : 0)  // 5. Volume 30%+ above average (institutional interest)
buyScore := buyScore + (suiteBuySignal ? 1 : 0)  // 6. Suite diamonds bullish
buyScore := buyScore + (greenMountainUp or (gmStrength < 0 and gmStrength > gmStrength[1]) ? 1 : 0)  // 7. Building strength or reversing
buyScore := buyScore + (rsiOversoldCond or (rsiValue > rsiOversold and rsiValue < 45) ? 1 : 0)  // 8. RSI oversold or early recovery
buyScore := buyScore + (macdBullishCross ? 1 : 0)  // 9. MACD bullish cross
buyScore := buyScore + (adxStrong ? 1 : 0)  // 10. ADX shows trend strength

// SELL Criteria (Optimized for taking profits / avoiding tops)
int sellScore = 0
sellScore := sellScore + ((weeklyDowntrend or weeklyOverbought) ? 1 : 0)  // 1. Weekly trend down OR overbought top
sellScore := sellScore + (dailyDowntrend or dailyReversal ? 1 : 0)  // 2. Daily trend down or reversal
sellScore := sellScore + (lowerHigh4H ? 1 : 0)  // 3. 4H forming lower highs
sellScore := sellScore + (vwapLoss ? 1 : 0)  // 4. Price loses VWAP
sellScore := sellScore + (volumeIncreased ? 1 : 0)  // 5. Volume 30%+ above average (distribution)
sellScore := sellScore + (suiteSellSignal ? 1 : 0)  // 6. Suite diamonds bearish
sellScore := sellScore + (greenMountainLoss ? 1 : 0)  // 7. Green mountain exhaustion
sellScore := sellScore + (rsiOverboughtCond ? 1 : 0)  // 8. RSI overbought
sellScore := sellScore + (macdBearishCross ? 1 : 0)  // 9. MACD bearish cross
sellScore := sellScore + (adxStrong ? 1 : 0)  // 10. ADX shows trend strength

// ==================================================================================
// SIGNAL GENERATION
// ==================================================================================

// Generate signals only when minimum criteria met
buySignalRaw = buyScore >= minCriteria
sellSignalRaw = sellScore >= minCriteria

// Prevent duplicate signals and ensure minimum spacing (avoid overtrading)
var bool inPosition = false
var float entryPrice = na
var int signalBar = na

// Only signal if enough bars have passed since last signal (for swing trades)
bool enoughTimePassed = na(signalBar) or (bar_index - signalBar) >= minBarsFromLast

buySignal = buySignalRaw and not inPosition and enoughTimePassed
sellSignal = sellSignalRaw and inPosition

if buySignal
    inPosition := true
    entryPrice := close
    signalBar := bar_index

if sellSignal
    inPosition := false
    entryPrice := na
    signalBar := na

// ==================================================================================
// STOP LOSS AND TARGET CALCULATIONS
// ==================================================================================

stopLossPrice = inPosition ? entryPrice * (1 - stopLossPct / 100) : na
target1Price = inPosition ? entryPrice * (1 + firstTargetPct / 100) : na
target2Price = inPosition ? entryPrice * (1 + secondTargetPct / 100) : na
target3Price = inPosition ? entryPrice * (1 + thirdTargetPct / 100) : na

// ==================================================================================
// PLOTTING AND VISUAL SIGNALS
// ==================================================================================

// Plot VWAP
plot(vwapValue, "VWAP", color=color.new(color.yellow, 50), linewidth=2)

// Plot Buy/Sell Signals
plotshape(buySignal and not inPosition[1], "BUY SIGNAL", shape.triangleup, location.belowbar,
         buyColor, size=size.large, text="BUY HERE")
plotshape(sellSignal and inPosition[1], "SELL SIGNAL", shape.triangledown, location.abovebar,
         sellColor, size=size.large, text="SELL HERE")

// Plot Stop Loss
plot(showStopLoss and not na(stopLossPrice) ? stopLossPrice : na, "Stop Loss -10%",
     color=color.new(color.red, 0), linewidth=2, style=plot.style_linebr)

// Plot Targets
plot(showTargets and not na(target1Price) ? target1Price : na, "Target 1: +20% (Trim 30%)",
     color=color.new(color.green, 0), linewidth=1, style=plot.style_linebr)
plot(showTargets and not na(target2Price) ? target2Price : na, "Target 2: +50% (Trim 40%)",
     color=color.new(color.green, 30), linewidth=2, style=plot.style_linebr)
plot(showTargets and not na(target3Price) ? target3Price : na, "Target 3: +100% (Moon)",
     color=color.new(color.green, 50), linewidth=2, style=plot.style_linebr)

// Labels for signals (Improved formatting)
if buySignal
    string labelText = "BUY"
    labelText := labelText + "\nScore: " + str.tostring(buyScore) + "/10"
    labelText := labelText + "\n━━━━━━━━━━━━"
    labelText := labelText + "\nEntry: $" + str.tostring(close, format.mintick)
    labelText := labelText + "\nStop: $" + str.tostring(close * (1 - stopLossPct / 100), format.mintick)
    labelText := labelText + "\n━━━━━━━━━━━━"
    labelText := labelText + "\nT1 (+20%): $" + str.tostring(close * (1 + firstTargetPct / 100), format.mintick)
    labelText := labelText + "\nT2 (+50%): $" + str.tostring(close * (1 + secondTargetPct / 100), format.mintick)
    labelText := labelText + "\nT3 (+100%): $" + str.tostring(close * (1 + thirdTargetPct / 100), format.mintick)

    label.new(bar_index, low,
             text=labelText,
             color=buyColor, textcolor=color.white, style=label.style_label_up, size=size.normal)

if sellSignal
    string labelText = "SELL"
    labelText := labelText + "\nScore: " + str.tostring(sellScore) + "/10"
    labelText := labelText + "\n━━━━━━━━━━━━"
    labelText := labelText + "\nExit: $" + str.tostring(close, format.mintick)
    if not na(entryPrice)
        float profitPct = (close - entryPrice) / entryPrice * 100
        labelText := labelText + "\nProfit: " + str.tostring(profitPct, "#.##") + "%"

    label.new(bar_index, high,
             text=labelText,
             color=sellColor, textcolor=color.white, style=label.style_label_down, size=size.normal)

// ==================================================================================
// ALERTS
// ==================================================================================

alertcondition(buySignal, "BUY Signal", "BUY SIGNAL - High quality swing setup detected!")
alertcondition(sellSignal, "SELL Signal", "SELL SIGNAL - Exit position now")
alertcondition(close <= stopLossPrice and not na(stopLossPrice), "Stop Loss Hit", "STOP LOSS HIT - Exit immediately!")
alertcondition(close >= target1Price and not na(target1Price), "Target 1 Reached", "TARGET 1 (+20%) - Trim 30% of position")
alertcondition(close >= target2Price and not na(target2Price), "Target 2 Reached", "TARGET 2 (+50%) - Trim 40% more")
alertcondition(close >= target3Price and not na(target3Price), "Target 3 Reached", "TARGET 3 (+100%) - MOON SHOT achieved!")

// ==================================================================================
// TABLE DISPLAY (Current Status)
// ==================================================================================

var table statusTable = table.new(position.top_right, 2, 13, border_width=2)

if barstate.islast
    table.cell(statusTable, 0, 0, "Indicator", bgcolor=color.new(color.gray, 70), text_color=color.white)
    table.cell(statusTable, 1, 0, "Status", bgcolor=color.new(color.gray, 70), text_color=color.white)

    table.cell(statusTable, 0, 1, "1W Trend", text_color=color.white)
    table.cell(statusTable, 1, 1, weeklyUptrend ? "UP ✓" : weeklyDowntrend ? "DOWN ✓" : weeklyOversold ? "OVERSOLD ✓" : weeklyOverbought ? "OVERBOUGHT" : "NEUTRAL",
              bgcolor=weeklyUptrend ? color.new(color.green, 70) : weeklyDowntrend ? color.new(color.red, 70) : weeklyOversold ? color.new(color.green, 50) : weeklyOverbought ? color.new(color.red, 50) : color.new(color.gray, 70),
              text_color=color.white)

    table.cell(statusTable, 0, 2, "1D Trend", text_color=color.white)
    table.cell(statusTable, 1, 2, dailyUptrend ? "UP ✓" : dailyDowntrend ? "DOWN ✓" : "REVERSAL",
              bgcolor=dailyUptrend ? color.new(color.green, 70) : dailyDowntrend ? color.new(color.red, 70) : color.new(color.orange, 70),
              text_color=color.white)

    table.cell(statusTable, 0, 3, "4H Structure", text_color=color.white)
    table.cell(statusTable, 1, 3, higherLow4H ? "Higher Lows ✓" : lowerHigh4H ? "Lower Highs ✓" : "Neutral",
              bgcolor=higherLow4H ? color.new(color.green, 70) : lowerHigh4H ? color.new(color.red, 70) : color.new(color.gray, 70),
              text_color=color.white)

    table.cell(statusTable, 0, 4, "VWAP", text_color=color.white)
    table.cell(statusTable, 1, 4, close > vwapValue ? "Above ✓" : "Below",
              bgcolor=close > vwapValue ? color.new(color.green, 70) : color.new(color.red, 70),
              text_color=color.white)

    table.cell(statusTable, 0, 5, "Volume", text_color=color.white)
    table.cell(statusTable, 1, 5, volumeIncreased ? "High ✓" : "Normal",
              bgcolor=volumeIncreased ? color.new(color.green, 70) : color.new(color.gray, 70),
              text_color=color.white)

    table.cell(statusTable, 0, 6, "Suite Diamonds", text_color=color.white)
    table.cell(statusTable, 1, 6, suiteBuySignal ? "Bullish ✓" : suiteSellSignal ? "Bearish ✓" : "Neutral",
              bgcolor=suiteBuySignal ? color.new(color.green, 70) : suiteSellSignal ? color.new(color.red, 70) : color.new(color.gray, 70),
              text_color=color.white)

    table.cell(statusTable, 0, 7, "Green Mountain", text_color=color.white)
    table.cell(statusTable, 1, 7, greenMountainUp ? "Strong ✓" : greenMountainLoss ? "Weak ✓" : "Neutral",
              bgcolor=greenMountainUp ? color.new(color.green, 70) : greenMountainLoss ? color.new(color.red, 70) : color.new(color.gray, 70),
              text_color=color.white)

    table.cell(statusTable, 0, 8, "RSI", text_color=color.white)
    table.cell(statusTable, 1, 8, str.tostring(rsiValue, "#.##"),
              bgcolor=rsiOversoldCond ? color.new(color.green, 70) : rsiOverboughtCond ? color.new(color.red, 70) : color.new(color.gray, 70),
              text_color=color.white)

    table.cell(statusTable, 0, 9, "MACD", text_color=color.white)
    table.cell(statusTable, 1, 9, macdLine > signalLine ? "Bullish ✓" : "Bearish",
              bgcolor=macdLine > signalLine ? color.new(color.green, 70) : color.new(color.red, 70),
              text_color=color.white)

    table.cell(statusTable, 0, 10, "ADX", text_color=color.white)
    table.cell(statusTable, 1, 10, adxStrong ? str.tostring(adxValue, "#.##") + " ✓" : str.tostring(adxValue, "#.##"),
              bgcolor=adxStrong ? color.new(color.green, 70) : color.new(color.gray, 70),
              text_color=color.white)

    table.cell(statusTable, 0, 11, "Buy Score", text_color=color.white, bgcolor=color.new(buyColor, 70))
    table.cell(statusTable, 1, 11, str.tostring(buyScore) + "/" + str.tostring(minCriteria) + " min",
              bgcolor=buyScore >= minCriteria ? color.new(color.green, 50) : color.new(color.gray, 70),
              text_color=color.white)

    table.cell(statusTable, 0, 12, "Sell Score", text_color=color.white, bgcolor=color.new(sellColor, 70))
    table.cell(statusTable, 1, 12, str.tostring(sellScore) + "/" + str.tostring(minCriteria) + " min",
              bgcolor=sellScore >= minCriteria ? color.new(color.red, 50) : color.new(color.gray, 70),
              text_color=color.white)

// ==================================================================================
// NOTES AND ADJUSTMENTS
// ==================================================================================
//
// OPTIMIZED FOR SWING TRADING - 1 TO 8 WEEK HOLDS
// ==================================================================================
// This indicator is now configured for HIGH QUALITY swing trades targeting 20-100% moves
//
// DEFAULT SETTINGS (Quality > Quantity):
// - Minimum Criteria: 6/10 (very selective - only the best setups)
// - Stop Loss: -10% (hard stop, non-negotiable)
// - Targets: +20% (trim 30%), +50% (trim 40%), +100% (moon shot)
// - Min Bars Between Signals: 20 (prevents overtrading on 1H chart)
// - RSI Extremes: 25/75 (deeper oversold/overbought for major reversals)
// - Volume: 30%+ above average (institutional confirmation)
// - ADX: 30+ (strong trend confirmation)
//
// WEEKLY TIMEFRAME NOW INCLUDED:
// - Weekly trend alignment is now criterion #1 for BUY and SELL
// - Weekly oversold (RSI < 35) = major reversal setup
// - Weekly overbought (RSI > 65) = major top warning
// - This filters out noise and catches the BIG moves
//
// PARAMETER TUNING:
// - For MORE signals (lower quality): Decrease minCriteria to 4-5
// - For FEWER signals (higher quality): Increase minCriteria to 7-8
// - For volatile stocks (SOUN, CLSK): Increase stopLossPct to 12-15%
// - For more frequent trades: Decrease minBarsFromLast to 10-15
// - For very selective trades: Increase minBarsFromLast to 30-40
//
// SUITE DIAMONDS:
// - Current: 8/21 EMA (moderate pace)
// - Faster signals: 5/13 (more signals, more whipsaws)
// - Slower signals: 13/34 (fewer signals, stronger confirmation)
//
// VOLUME:
// - Current: 30% above average (strong confirmation)
// - Extremely selective: 50%+ (institutional accumulation only)
// - More lenient: 20% (standard confirmation)
//
// EXECUTION CHECKLIST (Manual):
// 1. Wait for BUY signal on chart (green triangle + label)
// 2. Verify score is 6+/10 (higher = better)
// 3. Check status table - verify weekly trend aligns
// 4. Enter position with 5-8% of account
