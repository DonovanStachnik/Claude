//@version=6
indicator("Daybreak Early Entry", shorttitle="Early Entry", overlay=false)

// ==================================================================================
// DAYBREAK EARLY ENTRY INDICATOR
// ==================================================================================
// Companion to main Daybreak indicator
// Shows early entry signals using Suite Diamond momentum (8/21 EMA crossover)
// Green/Red sun symbols appear BEFORE main chart confirmations
// ==================================================================================

// ==================================================================================
// INPUT SETTINGS
// ==================================================================================

// Display Settings
bool showHistogram = input.bool(true, "Show Momentum Histogram", group="Display")
bool showZeroLine = input.bool(true, "Show Zero Line", group="Display")

// Color Settings
color greenColor = input.color(color.new(#00FF00, 0), "Green Sun Color", group="Colors")
color redColor = input.color(color.new(#FF0000, 0), "Red Sun Color", group="Colors")

// ==================================================================================
// HELPER FUNCTIONS
// ==================================================================================

emaCalc(src, length) =>
    ta.ema(src, length)

smaCalc(src, length) =>
    ta.sma(src, length)

// ==================================================================================
// SUITE DIAMOND MOMENTUM CALCULATION
// ==================================================================================

// Same calculation as main Daybreak indicator
suiteFastEma = emaCalc(close, 8)
suiteSlowEma = emaCalc(close, 21)
suiteMacd = suiteFastEma - suiteSlowEma
suiteSignal = smaCalc(suiteMacd, 5)
suiteHistogram = suiteMacd - suiteSignal

// ==================================================================================
// EARLY ENTRY SIGNALS
// ==================================================================================

// These fire on crossover/crossunder - EARLIER than main indicator
// Main indicator waits for confirmation above/below zero
// This one fires immediately on the cross

greenSun = ta.crossover(suiteMacd, suiteSignal)  // Early bullish
redSun = ta.crossunder(suiteMacd, suiteSignal)   // Early bearish

// ==================================================================================
// VISUAL DISPLAY
// ==================================================================================

// Plot zero line
hline(showZeroLine ? 0 : na, "Zero Line", color=color.new(color.gray, 50), linestyle=hline.style_solid)

// Plot histogram
histColor = suiteHistogram > 0 ?
    (suiteHistogram > suiteHistogram[1] ? color.new(greenColor, 40) : color.new(greenColor, 70)) :
    (suiteHistogram < suiteHistogram[1] ? color.new(redColor, 40) : color.new(redColor, 70))

plot(showHistogram ? suiteHistogram : na, "Momentum", color=histColor, style=plot.style_histogram, linewidth=4)

// Plot MACD and Signal lines
plot(suiteMacd, "MACD", color=suiteMacd > suiteSignal ? greenColor : redColor, linewidth=2)
plot(suiteSignal, "Signal", color=color.new(color.gray, 30), linewidth=1, style=plot.style_line)

// ==================================================================================
// SUN SYMBOLS - Early Entry Signals
// ==================================================================================

// Green Sun (Early Bullish) - appears at bottom when crossover happens
plotchar(greenSun, "Green Sun ☀", "☀", location.bottom, greenColor, size=size.normal)

// Red Sun (Early Bearish) - appears at top when crossunder happens
plotchar(redSun, "Red Sun ☀", "☀", location.top, redColor, size=size.normal)

// ==================================================================================
// BACKGROUND COLOR - Shows current momentum state
// ==================================================================================

bgcolor(suiteMacd > 0 ? color.new(greenColor, 95) : color.new(redColor, 95), title="Momentum BG")

// ==================================================================================
// ALERTS
// ==================================================================================

alertcondition(greenSun, "Early Bullish Entry", "Daybreak Early: Green Sun ☀ - Early bullish entry signal!")
alertcondition(redSun, "Early Bearish Entry", "Daybreak Early: Red Sun ☀ - Early bearish entry signal!")

// ==================================================================================
// NOTES
// ==================================================================================
// DAYBREAK EARLY ENTRY INDICATOR
//
// This indicator shows the SAME Suite Diamond momentum system as the main Daybreak
// indicator, but displays it as an oscillator in a separate pane.
//
// KEY DIFFERENCE - EARLY SIGNALS:
// - Main Daybreak: Green sun appears when crossover happens AND MACD is above zero
// - Early Entry: Green sun appears IMMEDIATELY on crossover (regardless of position)
//
// USAGE:
// 1. Green ☀ at bottom = Early bullish entry (crossover happened)
// 2. Red ☀ at top = Early bearish entry (crossunder happened)
// 3. Histogram above zero = Bullish momentum
// 4. Histogram below zero = Bearish momentum
// 5. Bright histogram = Momentum increasing
// 6. Faded histogram = Momentum decreasing
//
// STRATEGY:
// - Aggressive: Enter on sun symbols here (earlier, more risk)
// - Conservative: Wait for sun symbols on main Daybreak chart (later, less risk)
// - Confirmation: Use both - early warning here, confirmation on main chart
// ==================================================================================
