//@version=6
indicator("Daybreak Early Entry", shorttitle="Early Entry", overlay=false)

// ==================================================================================
// DAYBREAK EARLY ENTRY INDICATOR
// ==================================================================================
// Companion to main Daybreak indicator
// Shows early entry signals using Suite Diamond momentum (8/21 EMA crossover)
// Green/Red sun symbols appear BEFORE main chart confirmations
// ==================================================================================

// ==================================================================================
// INPUT SETTINGS
// ==================================================================================

// Display Settings
bool showHistogram = input.bool(true, "Show Momentum Histogram", group="Display")
bool showZeroLine = input.bool(true, "Show Zero Line", group="Display")

// Color Settings
color greenColor = input.color(color.new(#00FF00, 0), "Green Sun Color", group="Colors")
color redColor = input.color(color.new(#FF0000, 0), "Red Sun Color", group="Colors")

// ==================================================================================
// HELPER FUNCTIONS
// ==================================================================================

emaCalc(src, length) =>
    ta.ema(src, length)

smaCalc(src, length) =>
    ta.sma(src, length)

// ==================================================================================
// SUITE DIAMOND MOMENTUM CALCULATION
// ==================================================================================

// Same calculation as main Daybreak indicator
suiteFastEma = emaCalc(close, 8)
suiteSlowEma = emaCalc(close, 21)
suiteMacd = suiteFastEma - suiteSlowEma
suiteSignal = smaCalc(suiteMacd, 5)
suiteHistogram = suiteMacd - suiteSignal

// ==================================================================================
// EARLY ENTRY SIGNALS - Momentum Shift Detection
// ==================================================================================

// These fire BEFORE crossover happens - detecting momentum shifts
// When histogram changes direction = early warning of upcoming crossover
// Main indicator shows crossover after it happens
// This shows momentum turning BEFORE the crossover

// Detect histogram direction changes (early momentum shift)
histIncreasing = suiteHistogram > suiteHistogram[1]
histDecreasing = suiteHistogram < suiteHistogram[1]
histWasDecreasing = suiteHistogram[1] < suiteHistogram[2]
histWasIncreasing = suiteHistogram[1] > suiteHistogram[2]

// Early bullish = histogram was decreasing, now starts increasing (momentum turning bullish)
// This happens BEFORE the MACD crosses above signal
greenSun = histWasDecreasing and histIncreasing and suiteHistogram < 0

// Early bearish = histogram was increasing, now starts decreasing (momentum turning bearish)
// This happens BEFORE the MACD crosses below signal
redSun = histWasIncreasing and histDecreasing and suiteHistogram > 0

// ==================================================================================
// VISUAL DISPLAY
// ==================================================================================

// Plot zero line
hline(showZeroLine ? 0 : na, "Zero Line", color=color.new(color.gray, 50), linestyle=hline.style_solid)

// Plot histogram
var color histColor = na
if suiteHistogram > 0
    histColor := suiteHistogram > suiteHistogram[1] ? color.new(greenColor, 40) : color.new(greenColor, 70)
else
    histColor := suiteHistogram < suiteHistogram[1] ? color.new(redColor, 40) : color.new(redColor, 70)

plot(showHistogram ? suiteHistogram : na, "Momentum", color=histColor, style=plot.style_histogram, linewidth=4)

// Plot MACD and Signal lines
plot(suiteMacd, "MACD", color=suiteMacd > suiteSignal ? greenColor : redColor, linewidth=2)
plot(suiteSignal, "Signal", color=color.new(color.gray, 30), linewidth=1, style=plot.style_line)

// ==================================================================================
// SUN SYMBOLS - Early Entry Signals
// ==================================================================================

// Green Sun (Early Bullish) - appears at bottom when momentum starts turning bullish
plotchar(greenSun, title="Early Green Sun", char="☀", location=location.bottom, color=greenColor, size=size.tiny)

// Red Sun (Early Bearish) - appears at top when momentum starts turning bearish
plotchar(redSun, title="Early Red Sun", char="☀", location=location.top, color=redColor, size=size.tiny)

// ==================================================================================
// BACKGROUND COLOR - Shows current momentum state
// ==================================================================================

bgcolor(suiteMacd > 0 ? color.new(greenColor, 95) : color.new(redColor, 95), title="Momentum BG")

// ==================================================================================
// ALERTS
// ==================================================================================

alertcondition(greenSun, "Early Bullish Warning", "Daybreak Early: Green Sun ☀ - Momentum turning bullish! Crossover coming soon.")
alertcondition(redSun, "Early Bearish Warning", "Daybreak Early: Red Sun ☀ - Momentum turning bearish! Crossunder coming soon.")

// ==================================================================================
// NOTES
// ==================================================================================
// DAYBREAK EARLY ENTRY INDICATOR
//
// This indicator shows the SAME Suite Diamond momentum system as the main Daybreak
// indicator, but displays it as an oscillator in a separate pane.
//
// KEY DIFFERENCE - EARLY vs CONFIRMED SIGNALS:
// - Early Entry (this pane): Sun appears when HISTOGRAM changes direction (1-3 bars early)
// - Main Daybreak (chart): Sun appears when MACD crosses signal line (confirmation)
// - Early Entry gives advance warning, Main Daybreak confirms the move
//
// USAGE:
// 1. Green ☀ at bottom = Early bullish warning (momentum turning bullish, crossover coming soon)
// 2. Red ☀ at top = Early bearish warning (momentum turning bearish, crossunder coming soon)
// 3. Histogram above zero = Bullish momentum
// 4. Histogram below zero = Bearish momentum
// 5. Bright histogram = Momentum increasing
// 6. Faded histogram = Momentum decreasing
//
// HOW IT'S EARLY:
// - This indicator shows suns when histogram CHANGES DIRECTION (momentum shift)
// - Main Daybreak shows suns when MACD CROSSES signal line (confirmation)
// - Histogram direction change happens 1-3 bars BEFORE the crossover
// - This gives you advance warning before the main chart confirms
//
// STRATEGY:
// 1. See sun here in Early Entry pane = Get ready (momentum shifting)
// 2. Wait for sun on main Daybreak chart = Confirmation (take the trade)
// 3. Use both together for best timing
// ==================================================================================
