//@version=6
indicator("Daybreak Volume Buildup", shorttitle="Volume Buildup", overlay=false)

// ==================================================================================
// DAYBREAK VOLUME BUILDUP INDICATOR
// ==================================================================================
// Tracks CUMULATIVE buying vs selling pressure over time
// Green buildup = Sustained accumulation (stacking)
// Red buildup = Sustained distribution (stacking)
// Shows if institutional money is flowing IN or OUT
// ==================================================================================

// ==================================================================================
// INPUT SETTINGS
// ==================================================================================

// Color Settings
color greenColor = input.color(color.new(#00FF00, 0), "Accumulation Color", group="Colors")
color redColor = input.color(color.new(#FF0000, 0), "Distribution Color", group="Colors")
color grayColor = input.color(color.new(#808080, 50), "Neutral Color", group="Colors")

// Volume Buildup Settings
int lookbackPeriod = input.int(50, "Buildup Lookback Period", minval=10, maxval=200, group="Settings")
bool showZeroLine = input.bool(true, "Show Zero Line", group="Display")

// ==================================================================================
// VOLUME BUILDUP CALCULATIONS
// ==================================================================================

// Calculate where price closed in the candle's range (0 to 1)
rangePosition = (high - low) != 0 ? (close - low) / (high - low) : 0.5

// Buying/Selling Volume for each bar
buyingVolume = rangePosition > 0.5 ? volume * (rangePosition - 0.5) * 2 : 0
sellingVolume = rangePosition < 0.5 ? volume * (0.5 - rangePosition) * 2 : 0

// Net pressure for this bar
netPressure = buyingVolume - sellingVolume

// CUMULATIVE BUILDUP - This is the key
// Positive = buying pressure building up (accumulation)
// Negative = selling pressure building up (distribution)
cumulativePressure = ta.cum(netPressure)

// Normalize the buildup to make it easier to read
// Calculate average over lookback period
avgPressure = ta.sma(math.abs(netPressure), lookbackPeriod)

// Scaled cumulative pressure (makes chart more readable)
scaledPressure = avgPressure > 0 ? cumulativePressure / (avgPressure * 10) : cumulativePressure

// Determine if we're in accumulation or distribution phase
// Based on CUMULATIVE trend, not individual bars
accumulationPhase = scaledPressure > 0 and scaledPressure > scaledPressure[1]
distributionPhase = scaledPressure < 0 and scaledPressure < scaledPressure[1]
accumulating = scaledPressure > 0
distributing = scaledPressure < 0

// Track sustained buildup (how long has cumulative pressure been building in same direction)
var int accumulationStreak = 0
var int distributionStreak = 0

if accumulationPhase
    accumulationStreak := accumulationStreak + 1
    distributionStreak := 0
else if distributionPhase
    distributionStreak := distributionStreak + 1
    accumulationStreak := 0
else
    // If trend weakens or reverses, reset streaks
    if scaledPressure > 0 and scaledPressure < scaledPressure[1]
        accumulationStreak := 0
    if scaledPressure < 0 and scaledPressure > scaledPressure[1]
        distributionStreak := 0

// Strong buildup signals (sustained pressure)
strongAccumulation = accumulationStreak >= 3
strongDistribution = distributionStreak >= 3

// ==================================================================================
// VISUAL DISPLAY
// ==================================================================================

// Plot zero line
hline(showZeroLine ? 0 : na, "Zero Line", color=color.new(color.white, 70), linestyle=hline.style_solid)

// Determine bar color based on CUMULATIVE pressure trend (not individual bar)
// This shows the buildup direction, not just whether current bar is up/down
var color volumeColor = na

// If cumulative pressure is positive (above zero)
if scaledPressure > 0
    // Bright green if building up, faded green if weakening
    volumeColor := scaledPressure > scaledPressure[1] ? greenColor : color.new(greenColor, 60)
// If cumulative pressure is negative (below zero)
else if scaledPressure < 0
    // Bright red if building down, faded red if weakening
    volumeColor := scaledPressure < scaledPressure[1] ? redColor : color.new(redColor, 60)
else
    volumeColor := grayColor

// Plot cumulative buildup as histogram (stacking effect)
plot(scaledPressure, "Volume Buildup", color=volumeColor, style=plot.style_histogram, linewidth=3)

// Background color for strong sustained pressure
bgcolor(strongAccumulation ? color.new(greenColor, 92) : strongDistribution ? color.new(redColor, 92) : na, title="Strong Buildup BG")

// ==================================================================================
// BUILDUP STRENGTH TABLE
// ==================================================================================

var table buildupTable = table.new(position.bottom_right, 2, 4, border_width=1)

if barstate.islast
    // Header
    table.cell(buildupTable, 0, 0, "Flow Type", bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.tiny)
    table.cell(buildupTable, 1, 0, "Status", bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.tiny)

    // Current direction
    table.cell(buildupTable, 0, 1, "Current", text_color=color.white, text_size=size.tiny)
    currentText = accumulating ? "ACCUMULATION" : distributing ? "DISTRIBUTION" : "NEUTRAL"
    currentColor = accumulating ? color.new(greenColor, 50) : distributing ? color.new(redColor, 50) : color.new(grayColor, 70)
    table.cell(buildupTable, 1, 1, currentText, bgcolor=currentColor, text_color=color.white, text_size=size.tiny)

    // Streak length
    table.cell(buildupTable, 0, 2, "Streak", text_color=color.white, text_size=size.tiny)
    streakCount = math.max(accumulationStreak, distributionStreak)
    streakColor = accumulationStreak > 0 ? color.new(greenColor, 50) : distributionStreak > 0 ? color.new(redColor, 50) : color.new(grayColor, 70)
    table.cell(buildupTable, 1, 2, str.tostring(streakCount) + " bars", bgcolor=streakColor, text_color=color.white, text_size=size.tiny)

    // Overall trend
    table.cell(buildupTable, 0, 3, "Trend", text_color=color.white, text_size=size.tiny)
    trendText = scaledPressure > 0 ? "BULLISH ✓" : "BEARISH"
    trendColor = scaledPressure > 0 ? color.new(greenColor, 50) : color.new(redColor, 50)
    table.cell(buildupTable, 1, 3, trendText, bgcolor=trendColor, text_color=color.white, text_size=size.tiny)

// ==================================================================================
// ALERTS
// ==================================================================================

alertcondition(strongAccumulation, "Strong Accumulation Buildup", "Daybreak Volume: Strong sustained accumulation - Institutional buying building up!")
alertcondition(strongDistribution, "Strong Distribution Buildup", "Daybreak Volume: Strong sustained distribution - Institutional selling building up!")

// Trend reversal alerts
buildupReversal = scaledPressure[1] < 0 and scaledPressure > 0
breakdownReversal = scaledPressure[1] > 0 and scaledPressure < 0

alertcondition(buildupReversal, "Accumulation Phase Started", "Daybreak Volume: Buildup phase started - Money flowing IN!")
alertcondition(breakdownReversal, "Distribution Phase Started", "Daybreak Volume: Distribution phase started - Money flowing OUT!")

// ==================================================================================
// NOTES
// ==================================================================================
// DAYBREAK VOLUME BUILDUP INDICATOR
//
// This indicator tracks CUMULATIVE buying/selling pressure to show
// if money is BUILDING UP (accumulation) or FLOWING OUT (distribution).
//
// HOW IT WORKS:
// - Each bar adds buying or selling pressure to the cumulative total
// - Close near high = Buying pressure (adds to green buildup)
// - Close near low = Selling pressure (adds to red buildup)
// - Bars stack up over time showing SUSTAINED institutional flow
//
// WHAT TO LOOK FOR:
//
// 1. STRONG ACCUMULATION BUILDUP (Green bars stacking):
//    - Histogram rising and staying green
//    - Sustained buying pressure (3+ bars)
//    - Background flashes green
//    - Table shows "ACCUMULATION" + "BULLISH ✓"
//    → Institutional money flowing IN - Look for bullish Daybreak signals
//
// 2. STRONG DISTRIBUTION BUILDUP (Red bars stacking):
//    - Histogram falling and staying red
//    - Sustained selling pressure (3+ bars)
//    - Background flashes red
//    - Table shows "DISTRIBUTION" + "BEARISH"
//    → Institutional money flowing OUT - Avoid or short
//
// 3. NEUTRAL/CHOPPY (Gray/mixed bars):
//    - Histogram oscillating around zero
//    - No sustained pressure
//    - Table shows "NEUTRAL"
//    → No institutional conviction - Wait for clear direction
//
// 4. TREND REVERSALS:
//    - Histogram crosses from negative to positive = Accumulation phase starting
//    - Histogram crosses from positive to negative = Distribution phase starting
//
// PERFECT SETUP WITH DAYBREAK:
// - Main chart shows green sun (bullish signal)
// - Early Entry shows tiny sun (early warning)
// - Volume Buildup shows GREEN stacking (sustained accumulation)
// - Streak shows 3+ bars of buying pressure
// = STRONG INSTITUTIONAL BACKING - High probability trade!
//
// FAKEOUT DETECTION:
// - Main chart shows green sun
// - Volume Buildup shows RED or oscillating (no sustained buying)
// = FAKEOUT - Skip this signal!
// ==================================================================================
