//@version=6
indicator("Daybreak Volume Strength", shorttitle="Volume Strength", overlay=false)

// ==================================================================================
// DAYBREAK VOLUME STRENGTH INDICATOR
// ==================================================================================
// Measures buying vs selling pressure strength on a scale of 0-4
// 1 = Weak distribution (RED)
// 2 = Neutral (GREY)
// 3 = Moderate accumulation (GREEN faded)
// 4 = Strong accumulation (GREEN bright)
// ==================================================================================

// ==================================================================================
// INPUT SETTINGS
// ==================================================================================

// Color Settings
color greenColor = input.color(color.new(#00FF00, 0), "Strong Buying Color", group="Colors")
color greenFaded = input.color(color.new(#00FF00, 50), "Moderate Buying Color", group="Colors")
color redColor = input.color(color.new(#FF0000, 0), "Distribution Color", group="Colors")
color grayColor = input.color(color.new(#808080, 50), "Neutral Color", group="Colors")

// Volume Strength Settings
int lookbackPeriod = input.int(20, "Volume Average Period", minval=5, maxval=100, group="Settings")
float strongThreshold = input.float(1.5, "Strong Volume Threshold", minval=1.0, maxval=3.0, step=0.1, group="Settings")
float moderateThreshold = input.float(0.8, "Moderate Volume Threshold", minval=0.3, maxval=1.5, step=0.1, group="Settings")

// ==================================================================================
// VOLUME STRENGTH CALCULATIONS
// ==================================================================================

// Calculate where price closed in the candle's range (0 to 1)
rangePosition = (high - low) != 0 ? (close - low) / (high - low) : 0.5

// Buying/Selling pressure calculation
// Close in upper half = buying pressure, lower half = selling pressure
buyingPressure = rangePosition > 0.5 ? (rangePosition - 0.5) * 2 : 0
sellingPressure = rangePosition < 0.5 ? (0.5 - rangePosition) * 2 : 0

// Net pressure for this bar (-1 to +1)
netPressure = buyingPressure - sellingPressure

// Volume-weighted pressure (high volume = more impact)
avgVolume = ta.sma(volume, lookbackPeriod)
volumeRatio = avgVolume > 0 ? volume / avgVolume : 1
weightedPressure = netPressure * volumeRatio

// SUSTAINED PRESSURE - Track over multiple bars with heavy smoothing
// Much longer period to avoid flipping on every bar
pressureTrend = ta.ema(weightedPressure, 20)  // 20-bar smoothing for trend

// Count consecutive bars of positive/negative pressure
var int bullishBars = 0
var int bearishBars = 0

if weightedPressure > moderateThreshold
    bullishBars := bullishBars + 1
    bearishBars := 0
else if weightedPressure < -moderateThreshold
    bearishBars := bearishBars + 1
    bullishBars := 0
else
    // Neutral bar - decay counters slowly (don't reset immediately)
    bullishBars := math.max(0, bullishBars - 1)
    bearishBars := math.max(0, bearishBars - 1)

// Volume surge detection
highVolume = volumeRatio > 1.3

// ==================================================================================
// STRENGTH LEVEL ASSIGNMENT (0-4)
// ==================================================================================

// STICKY LEVELS - Only change when sustained pressure confirms shift
// Requires multiple consecutive bars to change level (prevents whipsaws)

var float strengthLevel = 2  // Start at neutral

// Level 4: Strong sustained buying (requires 5+ bullish bars + high volume trend)
if bullishBars >= 5 and pressureTrend > strongThreshold and highVolume
    strengthLevel := 4

// Level 3: Moderate buying (requires 3+ bullish bars)
else if bullishBars >= 3 and pressureTrend > moderateThreshold
    strengthLevel := 3

// Level 1: Distribution (requires 5+ bearish bars)
else if bearishBars >= 5 and pressureTrend < -moderateThreshold
    strengthLevel := 1

// Level 2: Neutral (only when trend clearly neutral)
else if math.abs(pressureTrend) < moderateThreshold * 0.3 and bullishBars < 2 and bearishBars < 2
    strengthLevel := 2

// Otherwise MAINTAIN previous level (key for persistence)

// Track sustained strength (bars at same level)
var int level4Streak = 0
var int level3Streak = 0
var int level1Streak = 0

if strengthLevel == 4
    level4Streak := level4Streak + 1
    level3Streak := 0
    level1Streak := 0
else if strengthLevel == 3
    level3Streak := level3Streak + 1
    level4Streak := 0
    level1Streak := 0
else if strengthLevel == 1
    level1Streak := level1Streak + 1
    level4Streak := 0
    level3Streak := 0
else
    level4Streak := 0
    level3Streak := 0
    level1Streak := 0

// Detect sustained runs (3+ bars at strong levels)
sustainedBuying = level4Streak >= 3
sustainedSelling = level1Streak >= 3

// ==================================================================================
// VISUAL DISPLAY
// ==================================================================================

// Determine bar color based on strength level
var color barColor = na

if strengthLevel == 4
    // Strong buying - bright green
    barColor := greenColor
else if strengthLevel == 3
    // Moderate buying - faded green
    barColor := greenFaded
else if strengthLevel == 2
    // Neutral - grey
    barColor := grayColor
else if strengthLevel == 1
    // Distribution - red
    barColor := redColor
else
    barColor := grayColor

// Plot strength level as histogram (0-4 scale)
plot(strengthLevel, "Volume Strength", color=barColor, style=plot.style_histogram, linewidth=4)

// Reference lines
hline(2, "Neutral Line", color=color.new(color.white, 80), linestyle=hline.style_dashed)
hline(4, "Max Strength", color=color.new(greenColor, 80), linestyle=hline.style_dotted)
hline(1, "Distribution", color=color.new(redColor, 80), linestyle=hline.style_dotted)

// Background highlights for sustained runs
bgcolor(sustainedBuying ? color.new(greenColor, 93) : sustainedSelling ? color.new(redColor, 93) : na, title="Sustained Run BG")

// ==================================================================================
// ALERTS
// ==================================================================================

// Strength change alerts
level4Start = strengthLevel == 4 and strengthLevel[1] != 4
level1Start = strengthLevel == 1 and strengthLevel[1] != 1

alertcondition(level4Start, "Strong Buying Started", "Daybreak Volume: STRONG BUYING PRESSURE - Level 4!")
alertcondition(level1Start, "Distribution Started", "Daybreak Volume: DISTRIBUTION PRESSURE - Level 1!")

// Sustained run alerts
sustainedBuyingStart = sustainedBuying and not sustainedBuying[1]
sustainedSellingStart = sustainedSelling and not sustainedSelling[1]

alertcondition(sustainedBuyingStart, "Sustained Buying Run", "Daybreak Volume: SUSTAINED BUYING - 3+ bars of strong accumulation!")
alertcondition(sustainedSellingStart, "Sustained Selling Run", "Daybreak Volume: SUSTAINED SELLING - 3+ bars of distribution!")

// ==================================================================================
// NOTES
// ==================================================================================
// DAYBREAK VOLUME STRENGTH INDICATOR
//
// Measures current volume pressure strength on a fixed 0-4 scale.
// NOT cumulative - shows CURRENT strength only.
//
// STRENGTH LEVELS:
//
// Level 4 (BRIGHT GREEN) - Strong buying pressure
//   - High volume + close near high
//   - Institutional accumulation happening NOW
//   - Best confirmation for bullish Daybreak signals
//
// Level 3 (FADED GREEN) - Moderate buying pressure
//   - Decent volume + close in upper range
//   - Accumulation but not strong yet
//   - Wait for level 4 for best entries
//
// Level 2 (GREY) - Neutral / No conviction
//   - Low volume or mixed pressure
//   - Choppy, no institutional activity
//   - DO NOT TRADE
//
// Level 1 (RED) - Distribution / Selling pressure
//   - Volume with close near low
//   - Institutional selling
//   - Avoid longs, consider shorts
//
// PERFECT SETUP:
// - Early Entry shows tiny sun (early warning)
// - Main Daybreak shows green sun (trade signal)
// - Volume Strength shows LEVEL 4 (bright green)
// - All three align = HIGH PROBABILITY TRADE
//
// FAKEOUT DETECTION:
// - Main indicator shows bullish signal
// - Volume Strength shows Level 1 or Level 2
// - SKIP THE TRADE - No institutional support
//
// SUSTAINED RUNS:
// - 3+ consecutive bars at Level 4 = Strong sustained buying
// - 3+ consecutive bars at Level 1 = Strong sustained selling
// - Background highlights when sustained run detected
// ==================================================================================
