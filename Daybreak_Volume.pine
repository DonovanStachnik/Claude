//@version=6
indicator("Daybreak Volume", shorttitle="Volume", overlay=false)

// ==================================================================================
// DAYBREAK VOLUME INDICATOR
// ==================================================================================
// Simple volume indicator using Daybreak color scheme
// Green = Bullish volume (close > open)
// Red = Bearish volume (close < open)
// Gray = Neutral volume (close = open)
// ==================================================================================

// ==================================================================================
// INPUT SETTINGS
// ==================================================================================

// Color Settings
color greenColor = input.color(color.new(#00FF00, 0), "Bullish Volume Color", group="Colors")
color redColor = input.color(color.new(#FF0000, 0), "Bearish Volume Color", group="Colors")
color neutralColor = input.color(color.new(#808080, 50), "Neutral Volume Color", group="Colors")

// Volume Settings
int maLength = input.int(20, "Volume MA Length", minval=1, group="Settings")
bool showMA = input.bool(true, "Show Volume MA", group="Settings")

// ==================================================================================
// VOLUME CALCULATIONS
// ==================================================================================

// Determine volume color based on candle direction
bullishVolume = close > open
bearishVolume = close < open
neutralVolume = close == open

// Volume color logic
var color volumeColor = na
if bullishVolume
    volumeColor := greenColor
else if bearishVolume
    volumeColor := redColor
else
    volumeColor := neutralColor

// Volume Moving Average
volumeMA = ta.sma(volume, maLength)

// ==================================================================================
// VISUAL DISPLAY
// ==================================================================================

// Plot volume bars
plot(volume, "Volume", color=volumeColor, style=plot.style_histogram, linewidth=2)

// Plot volume moving average
plot(showMA ? volumeMA : na, "Volume MA", color=color.new(color.white, 30), linewidth=2, style=plot.style_line)

// ==================================================================================
// ALERTS
// ==================================================================================

// High volume alert (volume > 2x average)
highVolume = volume > volumeMA * 2.0
alertcondition(highVolume, "High Volume", "Daybreak Volume: Volume spike detected (2x average)!")

// ==================================================================================
// NOTES
// ==================================================================================
// DAYBREAK VOLUME INDICATOR
//
// Simple volume bars colored by candle direction:
// - Green bars = Bullish volume (close > open)
// - Red bars = Bearish volume (close < open)
// - Gray bars = Neutral volume (close = open, rare)
//
// White line = 20-period volume moving average
//
// USAGE:
// - Bright green volume on green candles = Strong bullish buying
// - Bright red volume on red candles = Strong bearish selling
// - Volume above MA = Higher than average activity
// - Volume below MA = Lower than average activity
// ==================================================================================
