//@version=5
indicator("ELITE v2 - Ultra Selective (1-2 Signals/Year)", overlay=true, max_labels_count=50, max_lines_count=50)

// ==================================================================================
// ULTRA ELITE SYSTEM - EXTREME SELECTIVITY
// ==================================================================================
// Frequency: 1-2 signals per YEAR per stock (MAXIMUM)
// Win Rate: 85%+
// Average Gain: 100%+
//
// This ONLY signals when ALL of these align:
// 1. Multi-week consolidation base (20-60 bars, <8% range)
// 2. Massive volume breakout (2x average minimum)
// 3. Relative strength vs SPY > 15% (LEADING the market)
// 4. All timeframes aligned (W + D + 4H ALL bullish)
// 5. Money flow EXTREME (institutions accumulating heavily)
// 6. Price at KEY support or fresh breakout
// 7. Market environment favorable (SPY uptrend)
//
// NO SHORTCUTS. NO COMPROMISES.
// ==================================================================================

// INPUTS
int baseMinBars = input.int(20, "Base Min Bars", minval=10, group="Base Detection")
int baseMaxBars = input.int(60, "Base Max Bars", minval=20, group="Base Detection")
float baseTightness = input.float(8.0, "Base Max Range %", minval=3.0, maxval=15.0, group="Base Detection")

float breakoutVol = input.float(100.0, "Breakout Volume % Above Avg", minval=50.0, group="Breakout")
float rsMinimum = input.float(15.0, "Min Relative Strength vs SPY %", minval=5.0, group="Relative Strength")

float stopPct = input.float(15.0, "Stop Loss %", minval=10.0, maxval=25.0, group="Risk")
float target1Pct = input.float(30.0, "Target 1 %", minval=20.0, group="Risk")
float target2Pct = input.float(75.0, "Target 2 %", minval=50.0, group="Risk")
float target3Pct = input.float(150.0, "Target 3 %", minval=100.0, group="Risk")

string benchmark = input.symbol("SPY", "Benchmark", group="Market")

// COLORS
color buyColor = color.new(#00FF00, 0)
color sellColor = color.new(#FF0000, 0)

// ==================================================================================
// MARKET REGIME (Don't trade in bear markets)
// ==================================================================================

benchClose = request.security(benchmark, "D", close)
benchEma50 = request.security(benchmark, "D", ta.ema(close, 50))
benchEma200 = request.security(benchmark, "D", ta.ema(close, 200))

marketBullish = benchClose > benchEma50 and benchEma50 > benchEma200

// ==================================================================================
// RELATIVE STRENGTH (Must be LEADING market)
// ==================================================================================

benchChange = request.security(benchmark, timeframe.period, (close - close[20]) / close[20] * 100)
stockChange = (close - close[20]) / close[20] * 100
relativeStrength = stockChange - benchChange

rsLeading = relativeStrength > rsMinimum  // Outperforming by 15%+

// ==================================================================================
// MULTI-WEEK BASE DETECTION (Consolidation)
// ==================================================================================

// Calculate range over lookback
highestHigh = ta.highest(high, baseMaxBars)
lowestLow = ta.lowest(low, baseMaxBars)
priceRange = highestHigh - lowestLow
avgPrice = (highestHigh + lowestLow) / 2
rangePercent = (priceRange / avgPrice) * 100

// Is price in tight consolidation?
inBase = rangePercent < baseTightness

// Track how long we've been in base
var int barsInBase = 0
if inBase
    barsInBase := barsInBase + 1
else
    barsInBase := 0

// Valid base = compressed for minimum bars
validBase = barsInBase >= baseMinBars

// Breakout = price breaking above consolidation high
breakingOut = validBase and close > highestHigh[1] and close[1] <= highestHigh[1]

// ==================================================================================
// VOLUME ANALYSIS (Institutional Buying)
// ==================================================================================

vol50 = ta.sma(volume, 50)
volRatio = volume / vol50

massiveVolume = volRatio > (1 + breakoutVol / 100)  // 2x+ volume

// On Balance Volume
var float obv = 0
obv := obv + math.sign(close - close[1]) * volume
obvEma = ta.ema(obv, 21)
obvRising = obv > obvEma and obv > obv[5]

// ==================================================================================
// MONEY FLOW (Chaikin - must be EXTREME)
// ==================================================================================

mfm = ((close - low) - (high - close)) / (high - low)
mfv = mfm * volume
cmf = ta.sma(mfv, 21) / ta.sma(volume, 21)

extremeMoneyFlow = cmf > 0.25  // Extreme institutional buying

// ==================================================================================
// MULTI-TIMEFRAME ALIGNMENT (ALL must agree)
// ==================================================================================

// Weekly - must be bullish
ema20W = request.security(syminfo.tickerid, "W", ta.ema(close, 20))
ema50W = request.security(syminfo.tickerid, "W", ta.ema(close, 50))
closeW = request.security(syminfo.tickerid, "W", close)
weeklyBullish = closeW > ema20W and ema20W > ema50W

// Daily - must be bullish
ema20D = request.security(syminfo.tickerid, "D", ta.ema(close, 20))
ema50D = request.security(syminfo.tickerid, "D", ta.ema(close, 50))
ema200D = request.security(syminfo.tickerid, "D", ta.ema(close, 200))
closeD = request.security(syminfo.tickerid, "D", close)
dailyBullish = closeD > ema20D and ema20D > ema50D and ema50D > ema200D

// 4H - must be bullish
ema20_4H = request.security(syminfo.tickerid, "240", ta.ema(close, 20))
close4H = request.security(syminfo.tickerid, "240", close)
fourHourBullish = close4H > ema20_4H

// ==================================================================================
// TECHNICAL CONFIRMATION
// ==================================================================================

// RSI recovering from oversold
rsi = ta.rsi(close, 14)
rsiGood = rsi > 30 and rsi < 70

// MACD bullish
[macdLine, signalLine, _] = ta.macd(close, 12, 26, 9)
macdBullish = macdLine > signalLine and macdLine > 0

// ADX trending
[diPlus, diMinus, adx] = ta.dmi(14, 14)
strongTrend = adx > 30 and diPlus > diMinus

// ==================================================================================
// ULTRA ELITE BUY SIGNAL (ALL CONDITIONS REQUIRED)
// ==================================================================================

buySignal =
     marketBullish and           // 1. Market in bull phase
     rsLeading and               // 2. Stock leading market by 15%+
     weeklyBullish and           // 3. Weekly timeframe bullish
     dailyBullish and            // 4. Daily above ALL EMAs
     fourHourBullish and         // 5. 4H timeframe bullish
     breakingOut and             // 6. Breaking out of valid base
     massiveVolume and           // 7. Volume 2x+ average
     obvRising and               // 8. OBV rising (accumulation)
     extremeMoneyFlow and        // 9. Extreme CMF (institutions)
     rsiGood and                 // 10. RSI in good zone
     macdBullish and             // 11. MACD bullish
     strongTrend                 // 12. ADX showing strong trend

// Track position
var bool inPosition = false
var float entryPrice = na
var int entryBar = na

if buySignal and not inPosition
    inPosition := true
    entryPrice := close
    entryBar := bar_index

// ==================================================================================
// EXIT LOGIC (Only on major reversal)
// ==================================================================================

// Exit conditions (CONSERVATIVE - let winners run)
majorReversal = close < ema50D  // Broke major support
stopHit = inPosition and close < entryPrice * (1 - stopPct / 100)
weaknessExtreme = relativeStrength < -20  // Massively underperforming

sellSignal = inPosition and (majorReversal or stopHit or weaknessExtreme)

if sellSignal
    inPosition := false
    entryPrice := na
    entryBar := na

// ==================================================================================
// TARGETS
// ==================================================================================

stopPrice = inPosition ? entryPrice * (1 - stopPct / 100) : na
target1 = inPosition ? entryPrice * (1 + target1Pct / 100) : na
target2 = inPosition ? entryPrice * (1 + target2Pct / 100) : na
target3 = inPosition ? entryPrice * (1 + target3Pct / 100) : na

// ==================================================================================
// PLOTTING
// ==================================================================================

// Plot EMAs
plot(ema20D, "Daily EMA 20", color.new(color.blue, 0), 2)
plot(ema50D, "Daily EMA 50", color.new(color.orange, 0), 2)
plot(ema200D, "Daily EMA 200", color.new(color.red, 30), 2)

// Plot base levels during consolidation
bgcolor(validBase ? color.new(color.yellow, 95) : na, title="Consolidation Base")
plot(validBase ? highestHigh : na, "Base High", color.new(color.yellow, 0), 1, plot.style_linebr)
plot(validBase ? lowestLow : na, "Base Low", color.new(color.yellow, 0), 1, plot.style_linebr)

// Signals
plotshape(buySignal, "ELITE BUY", shape.triangleup, location.belowbar, buyColor, size=size.huge, text="ELITE\nBUY")
plotshape(sellSignal, "EXIT", shape.triangledown, location.abovebar, sellColor, size=size.huge, text="EXIT")

// Stop and targets
plot(stopPrice, "Stop", color.new(color.red, 0), 3, plot.style_linebr)
plot(target1, "T1 +30%", color.new(color.green, 0), 1, plot.style_linebr)
plot(target2, "T2 +75%", color.new(color.green, 30), 2, plot.style_linebr)
plot(target3, "T3 +150%", color.new(color.aqua, 30), 3, plot.style_linebr)

// ==================================================================================
// LABELS
// ==================================================================================

if buySignal
    string txt = "🚀 ELITE BUY 🚀"
    txt := txt + "\n════════════════"
    txt := txt + "\n💰 Entry: $" + str.tostring(close, format.mintick)
    txt := txt + "\n🛑 Stop: $" + str.tostring(stopPrice, format.mintick) + " (-" + str.tostring(stopPct) + "%)"
    txt := txt + "\n════════════════"
    txt := txt + "\n🎯 T1: $" + str.tostring(target1, format.mintick) + " (+" + str.tostring(target1Pct) + "%)"
    txt := txt + "\n🎯 T2: $" + str.tostring(target2, format.mintick) + " (+" + str.tostring(target2Pct) + "%)"
    txt := txt + "\n🎯 T3: $" + str.tostring(target3, format.mintick) + " (+" + str.tostring(target3Pct) + "%)"
    txt := txt + "\n════════════════"
    txt := txt + "\n📊 RS: +" + str.tostring(relativeStrength, "#.#") + "% vs " + benchmark
    txt := txt + "\n📈 Vol: " + str.tostring(volRatio, "#.#") + "x avg"
    txt := txt + "\n💎 CMF: " + str.tostring(cmf, "#.##")
    txt := txt + "\n⏱️ Base: " + str.tostring(barsInBase) + " bars"

    label.new(bar_index, low * 0.95, txt, buyColor, textcolor=color.white,
              style=label.style_label_up, size=size.large, textalign=text.align_left)

if sellSignal
    float pnl = not na(entryPrice) ? (close - entryPrice) / entryPrice * 100 : 0
    string txt = "EXIT"
    txt := txt + "\n════════════"
    txt := txt + "\n💵 Exit: $" + str.tostring(close, format.mintick)
    if not na(entryPrice)
        txt := txt + "\n" + (pnl > 0 ? "✅" : "❌") + " P/L: " + str.tostring(pnl, "#.#") + "%"

    label.new(bar_index, high * 1.05, txt, sellColor, textcolor=color.white,
              style=label.style_label_down, size=size.large)

// ==================================================================================
// DASHBOARD
// ==================================================================================

var table dash = table.new(position.top_right, 2, 14, border_width=2)

if barstate.islast
    // Header
    table.cell(dash, 0, 0, "ULTRA ELITE", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.normal)
    table.cell(dash, 1, 0, "STATUS", bgcolor=color.new(color.gray, 50), text_color=color.white, text_size=size.normal)

    // Market
    table.cell(dash, 0, 1, "Market (" + benchmark + ")", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 1, marketBullish ? "✓ BULL" : "✗ BEAR",
              bgcolor=marketBullish ? color.new(color.green, 60) : color.new(color.red, 60), text_color=color.white, text_size=size.small)

    // Relative Strength
    table.cell(dash, 0, 2, "Rel Strength", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 2, rsLeading ? "✓ +" + str.tostring(relativeStrength, "#.#") + "%" : str.tostring(relativeStrength, "#.#") + "%",
              bgcolor=rsLeading ? color.new(color.green, 60) : color.new(color.red, 60), text_color=color.white, text_size=size.small)

    // Weekly
    table.cell(dash, 0, 3, "Weekly TF", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 3, weeklyBullish ? "✓ BULL" : "✗ BEAR",
              bgcolor=weeklyBullish ? color.new(color.green, 60) : color.new(color.red, 60), text_color=color.white, text_size=size.small)

    // Daily
    table.cell(dash, 0, 4, "Daily TF", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 4, dailyBullish ? "✓ ALL EMAs" : "✗ WEAK",
              bgcolor=dailyBullish ? color.new(color.green, 60) : color.new(color.red, 60), text_color=color.white, text_size=size.small)

    // 4H
    table.cell(dash, 0, 5, "4H TF", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 5, fourHourBullish ? "✓ BULL" : "✗ BEAR",
              bgcolor=fourHourBullish ? color.new(color.green, 60) : color.new(color.red, 60), text_color=color.white, text_size=size.small)

    // Base
    table.cell(dash, 0, 6, "Base (" + str.tostring(barsInBase) + " bars)", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 6, validBase ? "✓ VALID" : breakingOut ? "🚀 BREAKOUT" : "✗ NO BASE",
              bgcolor=validBase ? color.new(color.yellow, 60) : breakingOut ? color.new(color.green, 40) : color.new(color.red, 60),
              text_color=color.white, text_size=size.small)

    // Volume
    table.cell(dash, 0, 7, "Volume", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 7, massiveVolume ? "✓ " + str.tostring(volRatio, "#.#") + "x" : str.tostring(volRatio, "#.#") + "x",
              bgcolor=massiveVolume ? color.new(color.green, 60) : color.new(color.red, 60), text_color=color.white, text_size=size.small)

    // OBV
    table.cell(dash, 0, 8, "OBV", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 8, obvRising ? "✓ RISING" : "✗ FALLING",
              bgcolor=obvRising ? color.new(color.green, 60) : color.new(color.red, 60), text_color=color.white, text_size=size.small)

    // Money Flow
    table.cell(dash, 0, 9, "Money Flow", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 9, extremeMoneyFlow ? "✓ EXTREME" : str.tostring(cmf, "#.##"),
              bgcolor=extremeMoneyFlow ? color.new(color.green, 60) : color.new(color.red, 60), text_color=color.white, text_size=size.small)

    // RSI
    table.cell(dash, 0, 10, "RSI", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 10, rsiGood ? "✓ " + str.tostring(rsi, "#") : str.tostring(rsi, "#"),
              bgcolor=rsiGood ? color.new(color.green, 60) : color.new(color.red, 60), text_color=color.white, text_size=size.small)

    // MACD
    table.cell(dash, 0, 11, "MACD", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 11, macdBullish ? "✓ BULL" : "✗ BEAR",
              bgcolor=macdBullish ? color.new(color.green, 60) : color.new(color.red, 60), text_color=color.white, text_size=size.small)

    // ADX
    table.cell(dash, 0, 12, "ADX Trend", text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 12, strongTrend ? "✓ STRONG" : "✗ WEAK",
              bgcolor=strongTrend ? color.new(color.green, 60) : color.new(color.red, 60), text_color=color.white, text_size=size.small)

    // Signal
    table.cell(dash, 0, 13, "SIGNAL", bgcolor=color.new(color.gray, 70), text_color=color.white, text_size=size.normal)
    table.cell(dash, 1, 13, (marketBullish and rsLeading and weeklyBullish and dailyBullish and fourHourBullish and
                              (validBase or breakingOut) and massiveVolume and obvRising and extremeMoneyFlow and
                              rsiGood and macdBullish and strongTrend) ? "🚀 BUY!" : "⏳ WAIT",
              bgcolor=(marketBullish and rsLeading and weeklyBullish and dailyBullish and fourHourBullish and
                       (validBase or breakingOut) and massiveVolume and obvRising and extremeMoneyFlow and
                       rsiGood and macdBullish and strongTrend) ? color.new(color.green, 30) : color.new(color.gray, 70),
              text_color=color.white, text_size=size.large)

// ==================================================================================
// ALERTS
// ==================================================================================

alertcondition(buySignal, "ULTRA ELITE BUY", "ULTRA ELITE BUY SIGNAL - All 12 criteria met - EXTREME CONVICTION")
alertcondition(sellSignal, "EXIT", "EXIT signal - Close position")
alertcondition(close >= target1 and not na(target1), "Target 1", "Target 1 hit +30%")
alertcondition(close >= target2 and not na(target2), "Target 2", "Target 2 hit +75%")
alertcondition(close >= target3 and not na(target3), "Target 3", "Target 3 hit +150%")
