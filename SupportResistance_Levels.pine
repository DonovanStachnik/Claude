//@version=6
indicator("Support & Resistance Levels - Key Price Zones",
         shorttitle="S/R Levels",
         overlay=true,
         max_lines_count=500)

// ==================================================================================
// SUPPORT & RESISTANCE DETECTOR FOR SWING TRADING
// ==================================================================================
// Automatically identifies key support and resistance levels
// Support = Green horizontal lines (price tends to bounce here)
// Resistance = Red horizontal lines (price tends to reverse here)
// ==================================================================================

// ==================================================================================
// INPUT SETTINGS
// ==================================================================================

// Detection Settings
pivotLength = input.int(5, "Pivot Detection Length", minval=3, maxval=50, group="Detection",
                        tooltip="Number of bars to look left/right for pivot points")
maxLevels = input.int(5, "Max S/R Levels to Show", minval=1, maxval=10, group="Detection",
                      tooltip="Maximum number of support and resistance levels to display")
lookbackBars = input.int(500, "Lookback Period", minval=100, maxval=2000, group="Detection",
                         tooltip="How far back to search for S/R levels")

// Visual Settings
supportColor = input.color(color.new(#00FF00, 70), "Support Color", group="Visual")
resistanceColor = input.color(color.new(#FF0000, 70), "Resistance Color", group="Visual")
lineWidth = input.int(2, "Line Width", minval=1, maxval=5, group="Visual")
showLabels = input.bool(true, "Show Price Labels", group="Visual")

// ==================================================================================
// PIVOT DETECTION
// ==================================================================================

// Detect pivot highs (potential resistance)
pivotHigh = ta.pivothigh(high, pivotLength, pivotLength)

// Detect pivot lows (potential support)
pivotLow = ta.pivotlow(low, pivotLength, pivotLength)

// ==================================================================================
// SUPPORT & RESISTANCE LEVEL TRACKING
// ==================================================================================

// Store all detected pivot levels
var array<float> allPivotLows = array.new<float>()
var array<float> allPivotHighs = array.new<float>()

// Track new pivots
if not na(pivotLow)
    array.push(allPivotLows, pivotLow)
    // Keep array manageable
    if array.size(allPivotLows) > 100
        array.shift(allPivotLows)

if not na(pivotHigh)
    array.push(allPivotHighs, pivotHigh)
    // Keep array manageable
    if array.size(allPivotHighs) > 100
        array.shift(allPivotHighs)

// ==================================================================================
// FIND KEY LEVELS (Most Recent & Nearby)
// ==================================================================================

// Find support levels (recent lows near current price)
var array<float> topSupportLevels = array.new<float>()
topSupportLevels := array.new<float>()

if array.size(allPivotLows) > 0
    // Take most recent pivots and filter for ones near current price
    int startIdx = math.max(0, array.size(allPivotLows) - 50)  // Last 50 pivots
    for i = startIdx to array.size(allPivotLows) - 1
        float level = array.get(allPivotLows, i)
        // Only add if within reasonable range of current price
        if level >= close * 0.5 and level <= close * 1.5
            // Check if already added (avoid duplicates)
            bool isDuplicate = false
            if array.size(topSupportLevels) > 0
                for j = 0 to array.size(topSupportLevels) - 1
                    if math.abs(array.get(topSupportLevels, j) - level) < close * 0.01
                        isDuplicate := true
                        break
            if not isDuplicate
                array.push(topSupportLevels, level)
                if array.size(topSupportLevels) >= maxLevels
                    break

// Find resistance levels (recent highs near current price)
var array<float> topResistanceLevels = array.new<float>()
topResistanceLevels := array.new<float>()

if array.size(allPivotHighs) > 0
    // Take most recent pivots and filter for ones near current price
    int startIdx = math.max(0, array.size(allPivotHighs) - 50)  // Last 50 pivots
    for i = startIdx to array.size(allPivotHighs) - 1
        float level = array.get(allPivotHighs, i)
        // Only add if within reasonable range of current price
        if level >= close * 0.5 and level <= close * 1.5
            // Check if already added (avoid duplicates)
            bool isDuplicate = false
            if array.size(topResistanceLevels) > 0
                for j = 0 to array.size(topResistanceLevels) - 1
                    if math.abs(array.get(topResistanceLevels, j) - level) < close * 0.01
                        isDuplicate := true
                        break
            if not isDuplicate
                array.push(topResistanceLevels, level)
                if array.size(topResistanceLevels) >= maxLevels
                    break

// ==================================================================================
// VISUAL DISPLAY - HORIZONTAL LINES
// ==================================================================================

// Draw support levels (green lines)
if barstate.islast and array.size(topSupportLevels) > 0
    for i = 0 to array.size(topSupportLevels) - 1
        float level = array.get(topSupportLevels, i)

        // Draw short horizontal line (local view only)
        line.new(bar_index - 100, level, bar_index + 20, level,
                 color=supportColor, width=lineWidth, style=line.style_solid)

        // Add tiny price label without background
        if showLabels
            label.new(bar_index, level,
                     text=str.tostring(level, format.mintick),
                     color=color.new(color.white, 100),  // Fully transparent background
                     textcolor=supportColor,
                     style=label.style_label_left,
                     size=size.tiny)

// Draw resistance levels (red lines)
if barstate.islast and array.size(topResistanceLevels) > 0
    for i = 0 to array.size(topResistanceLevels) - 1
        float level = array.get(topResistanceLevels, i)

        // Draw short horizontal line (local view only)
        line.new(bar_index - 100, level, bar_index + 20, level,
                 color=resistanceColor, width=lineWidth, style=line.style_solid)

        // Add tiny price label without background
        if showLabels
            label.new(bar_index, level,
                     text=str.tostring(level, format.mintick),
                     color=color.new(color.white, 100),  // Fully transparent background
                     textcolor=resistanceColor,
                     style=label.style_label_left,
                     size=size.tiny)

// ==================================================================================
// ALERTS
// ==================================================================================

// Alert when price touches support
touchedSupport = false
if array.size(topSupportLevels) > 0
    for i = 0 to array.size(topSupportLevels) - 1
        float level = array.get(topSupportLevels, i)
        if low <= level * 1.005 and low >= level * 0.995
            touchedSupport := true

// Alert when price touches resistance
touchedResistance = false
if array.size(topResistanceLevels) > 0
    for i = 0 to array.size(topResistanceLevels) - 1
        float level = array.get(topResistanceLevels, i)
        if high >= level * 0.995 and high <= level * 1.005
            touchedResistance := true

alertcondition(touchedSupport, "Price at Support", "Price touching support level - potential bounce")
alertcondition(touchedResistance, "Price at Resistance", "Price touching resistance level - potential reversal")
